# Copy to .env (gitignored) or let `plexus doctor --fix` do it. Every value
# below has a working default in code — this file is for overriding a box that
# differs, not a list of things you must fill in before anything runs.

# Sandbox: the box-level pieces `plexus doctor` provisions.
# HEART_SANDBOX=1
# HEART_SANDBOX_IMAGE=heart-agent:latest
# HEART_MODEL_NETWORK=heart-egress
# HEART_EGRESS_CONTAINER=egress
# HEART_SANDBOX_PROXY_PORT=8888

# Concurrency. Local slots should match `llama-server --parallel`.
# HEART_LOCAL_SLOTS=3
# HEART_MAX_AGENTS_GLOBAL=6

# Where the fleet registry and the event journal live.
# PLEXUS_REGISTRY=~/.config/plexus/registry.json
# EVENT_JOURNAL_DIR=~/.local/share/heart/events

# Provider credentials belong in your shell (pass, 1Password, direnv), not here.
# A key in .env is one `git add -f` away from being public.
